# Build outputs and caches
.cache/
.gradle/
**/build/
**/dist/
.kotlin/
node_modules/
*.log
__pycache__/
*.pyc

# IDE / OS noise
.idea/
.vscode/
.DS_Store

# RuleSync local cache
fixture/.rulesync/.cache/

# Installed third-party Spec Kit dev extension + agent projections.
# These are full copies of upstream third-party source (Architecture Guard)
# and are reproduced deterministically by bootstrap.sh, so they are NOT
# committed into this repository.
fixture/.specify/extensions/
fixture/.claude/

# AEGL runtime overlays created by `aegl attach` on sandbox target fixtures.
# These are generated at test time and removed by `aegl detach`.
fixtures/**/.aegl/
fixtures/**/.github/

# AEGL Continuity Layer (v1.3): local runtime state. Handoff snapshots are
# local working artifacts; keeping them out of Git avoids noise and keeps
# `aegl resume` deterministic (see reports/V1.3-CONTINUITY-LAYER-REPORT.md).
.aegl/continuity/

# AEGL Persistent Work Memory (v1.4): Beads/Dolt runtime data is a local,
# machine-specific database. Never commit the DB, gate locks or caches — a
# fresh clone starts with no work graph (BEADS_DIR=<root>/.aegl/beads).
.aegl/beads/
.aegl/beads.gate.lock
.aegl/*.gate.lock*

# Command Code session/tool state (never committed).
.commandcode/

# NOTE: governance-required artifacts stay tracked on purpose:
#   governance/, scripts/, bridge/, fixture/ (project skeleton),
#   fixture/.specify/{memory,templates,scripts,workflows,integrations,extensions.yml},
#   fixture/.rulesync/, reports/, versions.json, upstream-lock.json, .github/
