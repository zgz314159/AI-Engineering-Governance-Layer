#!/usr/bin/env bash
# aegl-hermes-sandbox — run real Hermes (and its tool subprocesses) as the AI identity
# (aegl-ai), reaching the existing provider ONLY through the trusted model broker.
#
#   sudo aegl-hermes-sandbox --task <id> [--info-fd N] -- hermes ...
#
# /home/zhong is 0750 zhong:zhong. The launcher runs as root and does ONLY bwrap's
# mount/pid/net isolation and the declared-path mounts — no user namespace, so the host
# ids are preserved and root resolves the 0750 sources directly (no `--ro-bind-fd` fd
# trick). The FIRST in-sandbox process is a fixed trusted drop entry (setpriv) that
# clears groups/caps/env, sets no_new_privs, drops to the HOST aegl-ai, and only then
# starts the runner. No model/project code runs before the drop. Host HOME/project
# permissions are NOT changed; /home/zhong is a traversable skeleton with only the
# declared runtime, the android-stack profile, the guard source and the task dirs.
set -uo pipefail

BWRAP="/usr/bin/bwrap"
AI_USER="${AEGL_AI_USER:-aegl-ai}"
TRUSTED_TASK_REGISTRY="${AEGL_MODEL_TASK_REGISTRY:-/var/lib/aegl-model/registry.json}"
CONFIG="${AEGL_MODEL_CONFIG:-/etc/aegl/model/config}"
LIBDIR="${AEGL_MODEL_LIBDIR:-/usr/local/lib/aegl-model}"
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
pick(){ [ -f "$LIBDIR/$1" ] && printf '%s' "$LIBDIR/$1" || printf '%s' "$SELF_DIR/../recovery/$1"; }
BROKER_BIN="$LIBDIR/aegl-model-broker"; [ -x "$BROKER_BIN" ] || BROKER_BIN="$SELF_DIR/aegl-model-broker"
SHIM="$(pick loopback_shim.py)"
EXEC_SPEC="$(pick exec_spec.py)"
SPEC_PY="$(pick sandbox_spec.py)"
PREPARE="$(pick prepare_targets.py)"
DROP_VERIFY="$(pick drop_verify.py)"
SETPRIV="/usr/bin/setpriv"

say(){ printf '%s\n' "$*"; }
die(){ printf 'BLOCKED: %s\n' "$*" >&2; exit 1; }

TASK=""; INFO_FD=""; HERMES_ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --task) TASK="${2:-}"; shift 2 ;;
    --info-fd) INFO_FD="${2:-}"; shift 2 ;;
    --) shift; HERMES_ARGS=("$@"); break ;;
    *) die "unknown option: $1" ;;
  esac
done
[ "$(id -u)" = 0 ] || die "must run as root (to prepare mounts and drop to $AI_USER)"
case "$TASK" in ""|*[!A-Za-z0-9._-]*) die "restricted task_id required" ;; esac
[ "${#TASK}" -le 64 ] || die "task_id too long"
[ -f "$CONFIG" ] || die "trusted config not found: $CONFIG"
for b in "$BWRAP" "$EXEC_SPEC" "$SPEC_PY" "$PREPARE" "$DROP_VERIFY" "$SHIM" "$BROKER_BIN"; do [ -e "$b" ] || die "required component missing: $b"; done
# shellcheck disable=SC1090
. "$CONFIG"
for v in UPSTREAM CREDENTIAL_ENV CREDENTIAL_SOURCE HERMES_ENTRY HERMES_RUNTIME HERMES_TOOLS HERMES_INSTALLS HERMES_HOME_REAL HERMES_PROFILE_CONFIG; do
  [ -n "${!v:-}" ] || die "trusted config missing $v"
done
AI_UID="$(id -u "$AI_USER")"; AI_GID="$(id -g "$AI_USER")"; AI_GROUP="$(id -gn "$AI_USER")"

# --- required runtime paths, checked BEFORE any host change ------------------- #
[ -x "$HERMES_ENTRY" ] || die "Hermes entry not executable: $HERMES_ENTRY"
[ -d "$HERMES_RUNTIME" ] || die "Hermes runtime missing: $HERMES_RUNTIME"
[ -d "$HERMES_TOOLS" ] || die "Hermes Python toolchain missing: $HERMES_TOOLS"
[ -f "$HERMES_PROFILE_CONFIG" ] || die "guard/profile config missing: $HERMES_PROFILE_CONFIG"
grep -q '^hooks:' "$HERMES_PROFILE_CONFIG" || die "profile has no hooks block; refusing (no guard)"
PYBIN="$(head -1 "$HERMES_RUNTIME/.hermes/bin/hermes" 2>/dev/null | sed 's/^#!//')"
GUARD_SRC="$(grep -oE '/[^ ]*contract_guard\.py' "$HERMES_PROFILE_CONFIG" | head -1)"; GUARD_SRC="${GUARD_SRC%/*}"
[ -n "$GUARD_SRC" ] && [ -d "$GUARD_SRC" ] || die "contract-guard source dir not found (from the hooks)"
GUARD_DEST="$GUARD_SRC"
[ -x "$SETPRIV" ] || die "trusted drop entry not found: $SETPRIV"

# --- trusted task registry (root-owned; NOT the AI-writable task.json) -------- #
[ -f "$TRUSTED_TASK_REGISTRY" ] || die "trusted task registry not found: $TRUSTED_TASK_REGISTRY"
read -r WT SCR_R PROJ CONTRACT < <(python3 - "$TRUSTED_TASK_REGISTRY" "$TASK" <<'PY'
import json, sys
reg = json.load(open(sys.argv[1], encoding="utf-8"))
e = reg.get(sys.argv[2], {})
print(e.get("worktree", ""), e.get("scratch", ""), e.get("project", ""), e.get("contract_package", ""))
PY
)
[ -n "$WT" ] && [ -n "$SCR_R" ] || die "task not in the trusted registry: $TASK"
WT_R="$(realpath -e "$WT")" || die "worktree missing"; SCR_R="$(realpath -e "$SCR_R")" || die "scratch missing"
for p in "$WT_R" "$SCR_R"; do
  case "$p" in /tmp/*|/var/tmp/*|/run/aegl-*/*|/var/lib/aegl-*/*) : ;; *) die "task path outside the allowed bases: $p" ;; esac
done
[ "$(stat -c '%U' "$WT_R")" = "$AI_USER" ] || die "worktree not owned by $AI_USER"

# --- frozen contract package: from the trusted registry, matched to this task -- #
[ -n "$CONTRACT" ] && [ -f "$CONTRACT/implementation-contract.json" ] || die "trusted registry has no valid contract_package for $TASK"
python3 - "$CONTRACT" "$WT_R" <<'PY' || die "contract does not match the task dir"
import json, os, sys
pkg, wt = sys.argv[1], sys.argv[2]
c = json.load(open(os.path.join(pkg, "implementation-contract.json"), encoding="utf-8"))
pc = json.load(open(os.path.join(pkg, "project-context.json"), encoding="utf-8"))
root = os.path.realpath(pc["source_root"]); wt = os.path.realpath(wt)
if not (wt == root or wt.startswith(root + os.sep)):
    sys.exit("worktree outside source_root")
rel = os.path.relpath(wt, root).replace(os.sep, "/")
if not any(rel == a.rstrip("/") or rel.startswith(a.rstrip("/") + "/") for a in c.get("allowed_paths", [])):
    sys.exit("worktree not authorized by allowed_paths")
sys.exit(0)
PY

# --- run dir + traversable /home/zhong skeleton ------------------------------- #
RUN="/run/aegl-model/$TASK"; rm -rf "$RUN"
SK="$RUN/stage/home-zhong"
mkdir -p "$RUN/broker" "$RUN/home" "$SK/.hermes/profiles/android-stack" "$SK/.local/bin" "$RUN/stage/run-aegl"
mkdir -p "$SK$(dirname "${GUARD_DEST#/home/zhong}")"   # parent chain for the guard source
chown root:"$AI_GROUP" "$RUN"; chmod 0755 "$RUN"
chown root:"$AI_GROUP" "$RUN/broker"; chmod 0750 "$RUN/broker"
chown "$AI_USER":"$AI_GROUP" "$RUN/home"; chmod 0750 "$RUN/home"
chown -R root:root "$RUN/stage"; chmod -R a+rX,o-w "$RUN/stage"
SOCK="$RUN/broker/model.sock"; PORT=8877

# --- trusted broker: credential read as DATA from its ORIGINAL location ------- #
AEGL_MODEL_SOCKET="$SOCK" AEGL_MODEL_UPSTREAM="$UPSTREAM" \
AEGL_MODEL_CREDENTIAL_ENV="$CREDENTIAL_ENV" AEGL_MODEL_CREDENTIAL_SOURCE="$CREDENTIAL_SOURCE" \
  "$BROKER_BIN" serve >"$RUN/broker.log" 2>&1 &
BPID=$!
cleanup(){ kill "$BPID" 2>/dev/null; rm -rf "$RUN"; }
trap cleanup EXIT TERM INT
for _ in $(seq 1 60); do [ -S "$SOCK" ] && break; sleep 0.1; done
[ -S "$SOCK" ] || die "model broker did not start (see $RUN/broker.log)"
chown root:"$AI_GROUP" "$SOCK"; chmod 0660 "$SOCK"

# --- task config + generated android-stack profile (hooks preserved) ---------- #
gen_config(){ python3 - "$HERMES_PROFILE_CONFIG" "$1" "$PORT" <<'PY'
import sys
src, dst, port = sys.argv[1], sys.argv[2], sys.argv[3]
keep, on = [], False
for line in open(src, encoding="utf-8").read().splitlines():
    if line.startswith("hooks:"):
        on = True; keep.append(line); continue
    if on:
        if line and not line[0].isspace():
            on = False
        else:
            keep.append(line)
with open(dst, "w", encoding="utf-8") as fh:
    fh.write("model:\n  provider: custom\n  base_url: http://127.0.0.1:%s/v1\n"
             "  api_key: aegl-sandbox-dummy\n  default: deepseek/deepseek-v4.1-flash\n" % port)
    fh.write("\n".join(keep).rstrip() + "\n")
PY
}
gen_config "$SK/.hermes/config.yaml" || die "config build failed"
cp "$SK/.hermes/config.yaml" "$SK/.hermes/profiles/android-stack/config.yaml"
: > "$RUN/stage/empty"; chmod 0644 "$RUN/stage/empty"
chown -R root:"$AI_GROUP" "$RUN/stage"; chmod -R g+rX,o-rwx "$RUN/stage"
chmod 0755 "$SK" "$SK/.hermes" "$SK/.hermes/profiles" "$SK/.hermes/profiles/android-stack" "$SK/.local/bin" "$RUN/stage/run-aegl" "$SK$(dirname "${GUARD_DEST#/home/zhong}")"

# --- in-sandbox runner -------------------------------------------------------- #
cat > "$RUN/sandbox-run.sh" <<EOF
#!/bin/bash
python3 '$SHIM' --listen 127.0.0.1:$PORT --unix '$SOCK' >/dev/null 2>&1 &
shim=\$!; sleep 0.6
"\$@"; rc=\$?
kill \$shim 2>/dev/null
exit \$rc
EOF
chmod 0755 "$RUN/sandbox-run.sh"

# --- bwrap spec (root mounts, no userns) + trusted drop entry ------------------ #
say "AEGL_HERMES_SANDBOX task=$TASK ai_uid=$AI_UID sandbox=on (root mounts, no userns; setpriv drop)"
SPEC="$RUN/spec.json"
python3 "$SPEC_PY" --bwrap "$BWRAP" --uid "$AI_UID" --gid "$AI_GID" --run "$RUN" \
  --wt "$WT_R" --scr "$SCR_R" --runtime "$HERMES_RUNTIME" --tools "$HERMES_TOOLS" \
  --entry "$HERMES_ENTRY" --installs "$HERMES_INSTALLS" --guard-src "$GUARD_SRC" \
  --guard-dest "$GUARD_DEST" --contract-package "$CONTRACT" --setpriv "$SETPRIV" \
  --drop-verify "$DROP_VERIFY" \
  ${INFO_FD:+--info-fd "$INFO_FD"} -- "${HERMES_ARGS[@]}" > "$SPEC" || die "spec build failed"
# create EVERY mount target under the read-only skeleton, derived from the ACTUAL argv
python3 "$PREPARE" "$SPEC" "$SK" || die "mount-target preparation failed"
chown -R root:"$AI_GROUP" "$RUN/stage"; chmod -R g+rX,o-rwx "$RUN/stage"
chmod 0755 "$SK" "$SK/.hermes" "$SK/.local/bin"
python3 "$EXEC_SPEC" "$SPEC"
rc=$?
kill "$BPID" 2>/dev/null
exit "$rc"
