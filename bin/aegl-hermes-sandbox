#!/usr/bin/env bash
# aegl-hermes-sandbox — run real Hermes (and its tool subprocesses) as the AI identity
# (aegl-ai), reaching the existing provider ONLY through the trusted model broker.
#
#   sudo aegl-hermes-sandbox --task <id> [--info-fd N] -- hermes ...
#
# /home/zhong is 0750 zhong:zhong. The trusted root launcher prepares the task dirs, config
# and a private mount-namespace alias view (root bind-mounts the declared sources to paths
# under the task dir, so aegl-ai need not traverse the real HOME's private parents). It then
# drops to the HOST aegl-ai (setpriv; groups + bounding/inheritable/ambient caps cleared,
# no_new_privs set) with a read-only identity check, and only THEN starts /usr/bin/bwrap as
# aegl-ai — a plain non-setuid bwrap using its AppArmor-permitted user namespace. There is
# NO capability-requiring identity switch inside bwrap. Host HOME/project permissions are
# NOT changed and the temporary aliases never propagate to the host.
set -uo pipefail

BWRAP="/usr/bin/bwrap"
AI_USER="${AEGL_AI_USER:-aegl-ai}"
TRUSTED_TASK_REGISTRY="${AEGL_MODEL_TASK_REGISTRY:-/var/lib/aegl-model/registry.json}"
CONFIG="${AEGL_MODEL_CONFIG:-/etc/aegl/model/config}"
LIBDIR="${AEGL_MODEL_LIBDIR:-/usr/local/lib/aegl-model}"
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
pick(){
  # When the caller PINS the lib dir (a frozen, verified copy) there is NO fallback to a
  # user-writable source tree: a missing dependency resolves to a path that cannot exist.
  if [ -f "$LIBDIR/$1" ]; then printf '%s' "$LIBDIR/$1"
  elif [ -n "${AEGL_MODEL_LIBDIR:-}" ]; then printf '%s' "$LIBDIR/.MISSING-$1"
  else printf '%s' "$SELF_DIR/../recovery/$1"; fi
}
BROKER_BIN="$LIBDIR/aegl-model-broker"; [ -x "$BROKER_BIN" ] || BROKER_BIN="$SELF_DIR/aegl-model-broker"
SHIM="$(pick loopback_shim.py)"
DIAG_PY="$(pick diag_events.py)"
MODEL_CONFIG_PY="$(pick model_config.py)"
EXEC_SPEC="$(pick exec_spec.py)"
SPEC_PY="$(pick sandbox_spec.py)"
PREPARE="$(pick prepare_targets.py)"
DROP_VERIFY="$(pick drop_verify.py)"
SETPRIV="/usr/bin/setpriv"

say(){ printf '%s\n' "$*"; }
die(){ printf 'BLOCKED: %s\n' "$*" >&2; exit 1; }

TASK=""; INFO_FD=""; HERMES_ARGS=(); CHECK_CMD=""; CHECK_BASELINE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --task) TASK="${2:-}"; shift 2 ;;
    --info-fd) INFO_FD="${2:-}"; shift 2 ;;
    --check) CHECK_CMD="${2:-}"; shift 2 ;;
    --check-baseline) CHECK_BASELINE=1; shift ;;
    --) shift; HERMES_ARGS=("$@"); break ;;
    *) die "unknown option: $1" ;;
  esac
done
[ -z "$CHECK_CMD" ] || [ "${#HERMES_ARGS[@]}" -eq 0 ] || die "--check takes no hermes args"
[ -z "$CHECK_BASELINE" ] || [ -n "$CHECK_CMD" ] || die "--check-baseline requires --check"
[ "$(id -u)" = 0 ] || die "must run as root (to prepare mounts and drop to $AI_USER)"
case "$TASK" in ""|*[!A-Za-z0-9._-]*) die "restricted task_id required" ;; esac
[ "${#TASK}" -le 64 ] || die "task_id too long"
# Entry-bind production gate (same checker as broker): before any sandbox prepare.
# Installed launcher only — tip source under AEGL does not affect this path until
# recovery/install-model-broker.sh reinstalls /usr/local/lib/aegl-model/aegl-hermes-sandbox.
ENTRY_BIND_POLICY=/etc/aegl/entry-bind/policy
ENTRY_BIND_CHECKER=/usr/local/lib/aegl-entry-bind/require-entry-binds.sh
if [ -e "$ENTRY_BIND_POLICY" ]; then
  [ -x "$ENTRY_BIND_CHECKER" ] || die "entry-bind policy present but checker missing: $ENTRY_BIND_CHECKER"
  bash "$ENTRY_BIND_CHECKER" || die "entry-bind live RW self-binds required before Hermes sandbox"
else
  say "ENTRY_BIND_STATE=NOT_DEPLOYED (hermes: not claiming protection)"
fi
[ -f "$CONFIG" ] || die "trusted config not found: $CONFIG"
for b in "$BWRAP" "$EXEC_SPEC" "$SPEC_PY" "$PREPARE" "$DROP_VERIFY" "$SHIM" "$BROKER_BIN" "$MODEL_CONFIG_PY"; do [ -e "$b" ] || die "required component missing: $b"; done
python3 "$MODEL_CONFIG_PY" --config "$CONFIG" validate || die "configure a provider with aegl-model-config save/use before running tasks"
# shellcheck disable=SC1090
. "$CONFIG"
for v in MODEL_ID MODEL_API AUTH_HEADER UPSTREAM CREDENTIAL_ENV CREDENTIAL_SOURCE HERMES_ENTRY HERMES_RUNTIME HERMES_TOOLS HERMES_INSTALLS HERMES_HOME_REAL HERMES_PROFILE_CONFIG; do
  [ -n "${!v:-}" ] || die "trusted config missing $v"
done

# --- diagnostic event sink: OFF by default, task-allowlisted (BRIDGE-DIAG-003 only) --- #
# Capture is enabled ONLY for the trusted diagnosis task id below; every other task behaves
# exactly as before and creates no sink. The path is DERIVED from the task id and is NEVER
# supplied by a caller, so an unprivileged caller cannot redirect root output. An existing
# sink dir is NEVER removed here; the trusted driver refuses to start if one already exists.
DIAG_ROOT=/var/tmp/aegl-diag
DIAG_ENABLED_TASKS=" BRIDGE-DIAG-003 BRIDGE-VERIFY-004 BRIDGE-VERIFY-007 BRIDGE-VERIFY-008 IAP-SMOKE-003 IAP-SMOKE-004 IAP-SMOKE-005 IAP-SMOKE-006 IAP-SMOKE-007 "
# a no-model check run must never append to the task's diagnostic sink
[ -n "$CHECK_CMD" ] && DIAG_ENABLED_TASKS=" "
DIAG_DIR=""
diag_ev(){ :; }
case "$DIAG_ENABLED_TASKS" in
  *" $TASK "*)
    DIAG_DIR="$DIAG_ROOT/$TASK"
    [ -e "$DIAG_PY" ] || die "required diagnostic component missing: $DIAG_PY"
    [ -e "$DIAG_DIR" ] || install -d -o root -g root -m 0700 -- "$DIAG_ROOT" "$DIAG_DIR"
    export AEGL_DIAG_DIR="$DIAG_DIR"
    diag_ev(){ python3 "$DIAG_PY" "$@"; }
    ;;
esac
diag_ev --phase sandbox_prep_begin --task "$TASK"
AI_UID="$(id -u "$AI_USER")"; AI_GID="$(id -g "$AI_USER")"; AI_GROUP="$(id -gn "$AI_USER")"

# --- required runtime paths, checked BEFORE any host change ------------------- #
[ -x "$HERMES_ENTRY" ] || die "Hermes entry not executable: $HERMES_ENTRY"
[ -d "$HERMES_RUNTIME" ] || die "Hermes runtime missing: $HERMES_RUNTIME"
[ -d "$HERMES_TOOLS" ] || die "Hermes Python toolchain missing: $HERMES_TOOLS"
[ -f "$HERMES_PROFILE_CONFIG" ] || die "guard/profile config missing: $HERMES_PROFILE_CONFIG"
grep -q '^hooks:' "$HERMES_PROFILE_CONFIG" || die "profile has no hooks block; refusing (no guard)"
PYBIN="$(head -1 "$HERMES_RUNTIME/.hermes/bin/hermes" 2>/dev/null | sed 's/^#!//')"
GUARD_SRC="$(grep -oE '/[^ ]*contract_guard\.py' "$HERMES_PROFILE_CONFIG" | head -1)"; GUARD_SRC="${GUARD_SRC%/*}"
[ -n "$GUARD_SRC" ] && [ -d "$GUARD_SRC" ] || die "contract-guard source dir not found (from the hooks)"
GUARD_DEST="$GUARD_SRC"
[ -x "$SETPRIV" ] || die "trusted drop entry not found: $SETPRIV"

# --- trusted task registry (root-owned; NOT the AI-writable task.json) -------- #
[ -f "$TRUSTED_TASK_REGISTRY" ] || die "trusted task registry not found: $TRUSTED_TASK_REGISTRY"
read -r WT SCR_R PROJ CONTRACT < <(python3 - "$TRUSTED_TASK_REGISTRY" "$TASK" <<'PY'
import json, sys
reg = json.load(open(sys.argv[1], encoding="utf-8"))
e = reg.get(sys.argv[2], {})
print(e.get("worktree", ""), e.get("scratch", ""), e.get("project", ""), e.get("contract_package", ""))
PY
)
[ -n "$WT" ] && [ -n "$SCR_R" ] || die "task not in the trusted registry: $TASK"
WT_R="$(realpath -e "$WT")" || die "worktree missing"; SCR_R="$(realpath -e "$SCR_R")" || die "scratch missing"
for p in "$WT_R" "$SCR_R"; do
  case "$p" in /tmp/*|/var/tmp/*|/run/aegl-*/*|/var/lib/aegl-*/*) : ;; *) die "task path outside the allowed bases: $p" ;; esac
done
[ "$(stat -c '%U' "$WT_R")" = "$AI_USER" ] || die "worktree not owned by $AI_USER"

# --- frozen contract package: from the trusted registry, matched to this task -- #
[ -n "$CONTRACT" ] && [ -f "$CONTRACT/implementation-contract.json" ] || die "trusted registry has no valid contract_package for $TASK"
python3 - "$CONTRACT" "$WT_R" <<'PY' || die "contract does not match the task dir"
import json, os, sys
pkg, wt = sys.argv[1], sys.argv[2]
c = json.load(open(os.path.join(pkg, "implementation-contract.json"), encoding="utf-8"))
pc = json.load(open(os.path.join(pkg, "project-context.json"), encoding="utf-8"))
root = os.path.realpath(pc["source_root"]); wt = os.path.realpath(wt)
if not (wt == root or wt.startswith(root + os.sep)):
    sys.exit("worktree outside source_root")
rel = os.path.relpath(wt, root).replace(os.sep, "/")
if not any(rel == a.rstrip("/") or rel.startswith(a.rstrip("/") + "/") for a in c.get("allowed_paths", [])):
    sys.exit("worktree not authorized by allowed_paths")
sys.exit(0)
PY

# --- run dir + traversable /home/zhong skeleton ------------------------------- #
RUN="/run/aegl-model/$TASK"; rm -rf "$RUN"
SK="$RUN/stage/home-zhong"
mkdir -p "$RUN/broker" "$RUN/home" "$SK/.hermes/profiles/android-stack" "$SK/.local/bin" "$RUN/stage/run-aegl"
mkdir -p "$SK$(dirname "${GUARD_DEST#/home/zhong}")"   # parent chain for the guard source
chown root:"$AI_GROUP" "$RUN"; chmod 0755 "$RUN"
chown root:"$AI_GROUP" "$RUN/broker"; chmod 0750 "$RUN/broker"
chown "$AI_USER":"$AI_GROUP" "$RUN/home"; chmod 0750 "$RUN/home"
chown -R root:root "$RUN/stage"; chmod -R a+rX,o-w "$RUN/stage"
SOCK="$RUN/broker/model.sock"; PORT=8877
BPID=""
cleanup(){ [ -n "$BPID" ] && kill "$BPID" 2>/dev/null; rm -rf "$RUN"; }
trap cleanup EXIT TERM INT

# --- guard wiring: needed by the generated profile mount in BOTH modes ------------------ #
# (the broker and the credential path below stay skipped for a --check run)
GUARD_COPY="$LIBDIR/guard/contract_guard.py"
GUARD_CLIENT="$(pick guard_hook_client.py)"
# Diagnostic-only observers: wired ONLY for an allowed diagnostic task (DIAG_DIR non-empty).
# --check clears DIAG_ENABLED_TASKS, so no observer, no task sink.
TOOL_CLIENT="$(pick tool_event_client.py)"
OBS_CONFIG="$(pick tool_observer_config.py)"
OBS_PRE_CMD=""; OBS_POST_CMD=""
if [ -n "$DIAG_DIR" ]; then
  [ -f "$TOOL_CLIENT" ] || die "diagnostic observer client missing: $TOOL_CLIENT"
  [ -f "$OBS_CONFIG" ] || die "hook wiring verifier missing: $OBS_CONFIG"
  OBS_PRE_CMD="python3 $TOOL_CLIENT --socket $SOCK --event pre_tool_call --timeout 0.5"
  OBS_POST_CMD="python3 $TOOL_CLIENT --socket $SOCK --event post_tool_call --timeout 0.5"
fi

# --- trusted broker: only for a real (modeled) run ------------------------------------ #
if [ -z "$CHECK_CMD" ]; then
# it ALSO answers pre_tool_call on the same socket, running the VERIFIED read-only guard copy
# under a fixed unprivileged runner (never the broker identity, never user-writable code).
GUARD_RUNNER="$(python3 -c 'import json,sys;print(json.dumps(sys.argv[1:]))' \
  "$SETPRIV" --reuid "$AI_UID" --regid "$AI_GID" --clear-groups --no-new-privs -- )"
AEGL_MODEL_SOCKET="$SOCK" AEGL_MODEL_UPSTREAM="$UPSTREAM" \
AEGL_MODEL_CREDENTIAL_ENV="$CREDENTIAL_ENV" AEGL_MODEL_CREDENTIAL_SOURCE="$CREDENTIAL_SOURCE" \
AEGL_MODEL_AUTH_HEADER="$AUTH_HEADER" \
AEGL_GUARD_PATH="$GUARD_COPY" AEGL_GUARD_RUNNER="$GUARD_RUNNER" \
AEGL_DIAG_DIR="${AEGL_DIAG_DIR:-}" AEGL_GUARD_EVIDENCE="${AEGL_TRIAL_EVIDENCE:-$AEGL_DIAG_DIR}" AEGL_GUARD_AI_UID="$AI_UID" \
AEGL_GUARD_AI_GID="$AI_GID" AEGL_TASK="$TASK" \
HERMES_CONTRACT_PACKAGE="$CONTRACT" \
  "$BROKER_BIN" serve >"$RUN/broker.log" 2>&1 &
BPID=$!
for _ in $(seq 1 60); do [ -S "$SOCK" ] && break; sleep 0.1; done
[ -S "$SOCK" ] || die "model broker did not start (see $RUN/broker.log)"
chown root:"$AI_GROUP" "$SOCK"; chmod 0660 "$SOCK"
else
say "  check mode: no broker, no shim, no model call, no credential read"
fi

# --- task config + generated android-stack profile ---------------------------- #
# The client is installed 0644 (not executable), so the hook must invoke it through an explicit
# interpreter. When the verified copy or the client is missing we FAIL rather than fall back to
# an unwired hook — the run must never proceed without the controller in the path.
if [ -f "$GUARD_COPY" ] && [ -f "$GUARD_CLIENT" ]; then
  AEGL_HOOK_CMD="python3 $GUARD_CLIENT --socket $SOCK"
else
  die "verified guard copy ($GUARD_COPY) or controller client ($GUARD_CLIENT) missing; refusing to start"
fi
gen_config(){ AEGL_HOOK_CMD="$AEGL_HOOK_CMD" python3 - "$HERMES_PROFILE_CONFIG" "$1" "$PORT" "$MODEL_ID" <<'PY'
import json, os, sys
src, dst, port, model_id = sys.argv[1:]
hook_cmd = os.environ.get("AEGL_HOOK_CMD") or ""
keep, on, in_pre, replaced = [], False, False, False
for line in open(src, encoding="utf-8").read().splitlines():
    if line.startswith("hooks:"):
        on = True; keep.append(line); continue
    if on:
        if line and not line[0].isspace():
            on = False
        else:
            stripped = line.strip()
            if stripped == "pre_tool_call:":
                in_pre = True
            elif stripped.endswith(":") and not stripped.startswith("-"):
                in_pre = False
            if in_pre and hook_cmd and not replaced and stripped.startswith("- command:"):
                indent = line[:len(line) - len(line.lstrip())]
                keep.append("%s- command: '%s'" % (indent, hook_cmd))
                replaced = True
                continue
            keep.append(line)
with open(dst, "w", encoding="utf-8") as fh:
    fh.write("model:\n  provider: custom\n  base_url: http://127.0.0.1:%s/v1\n"
             "  api_key: aegl-sandbox-dummy\n  api_mode: chat_completions\n"
             "  default: %s\n" % (port, json.dumps(model_id)))
    fh.write("\n".join(keep).rstrip() + "\n")
PY
}
gen_config "$SK/.hermes/config.yaml" || die "config build failed"
if [ -n "$OBS_PRE_CMD" ]; then
  python3 "$OBS_CONFIG" install "$SK/.hermes/config.yaml" \
    --pre-command "$OBS_PRE_CMD" --post-command "$OBS_POST_CMD" \
    || die "diagnostic observer config install failed"
fi
cp "$SK/.hermes/config.yaml" "$SK/.hermes/profiles/android-stack/config.yaml"

# Task-local shell-hooks allowlist: the exact approved event+command set.
# Diagnostics on: guard(pre) + pre observer + post observer = exactly 3.
# Otherwise: guard only. Hermes skips anything not exactly approved.
ALLOWLIST_SRC="$RUN/shell-hooks-allowlist.json"
AEGL_HOOK_CMD="$AEGL_HOOK_CMD" AEGL_OBS_PRE="$OBS_PRE_CMD" AEGL_OBS_POST="$OBS_POST_CMD" \
python3 - "$ALLOWLIST_SRC" <<'PY' || die "task allowlist build failed"
import json, os, sys
from datetime import datetime, timezone
dst = sys.argv[1]
cmds = [("pre_tool_call", os.environ.get("AEGL_HOOK_CMD") or "")]
pre = os.environ.get("AEGL_OBS_PRE") or ""
post = os.environ.get("AEGL_OBS_POST") or ""
if pre:
    cmds.append(("pre_tool_call", pre))
if post:
    cmds.append(("post_tool_call", post))
if not cmds[0][1]:
    sys.exit("empty AEGL_HOOK_CMD")
entries = []
for event, cmd in cmds:
    mtime = None
    script = next((t for t in cmd.split() if t.endswith(".py")), None)
    if script and os.path.isfile(script):
        mtime = datetime.fromtimestamp(os.path.getmtime(script), tz=timezone.utc).isoformat().replace("+00:00", "Z")
    entries.append({
        "event": event,
        "command": cmd,
        "approved_at": datetime.now(tz=timezone.utc).isoformat().replace("+00:00", "Z"),
        "script_mtime_at_approval": mtime,
    })
with open(dst, "w", encoding="utf-8") as fh:
    json.dump({"approvals": entries}, fh, indent=2, sort_keys=True)
    fh.write("\n")
os.chmod(dst, 0o444)
PY
# Exact wiring gate: reject missing, duplicate or extra approvals/hooks. Static only —
# actual hook firing is proven later by the task-scoped diagnostic records.
DIAG_FLAG=0; [ -n "$DIAG_DIR" ] && DIAG_FLAG=1
python3 "$OBS_CONFIG" verify "$SK/.hermes/profiles/android-stack/config.yaml" "$ALLOWLIST_SRC" \
  --guard-command "$AEGL_HOOK_CMD" \
  --pre-command "$OBS_PRE_CMD" --post-command "$OBS_POST_CMD" \
  --diagnostics "$DIAG_FLAG" \
  || die "hook wiring is not the exact approved set (diagnostics=$DIAG_FLAG)"
if [ "$DIAG_FLAG" = 1 ]; then
  say "  hook wiring approved: guard(pre,fail_closed) + pre observer + post observer; allowlist=3"
else
  say "  hook wiring approved: guard(pre,fail_closed) only; allowlist=1"
fi

: > "$RUN/stage/empty"; chmod 0644 "$RUN/stage/empty"
chown -R root:"$AI_GROUP" "$RUN/stage"; chmod -R g+rX,o-rwx "$RUN/stage"
chmod 0755 "$SK" "$SK/.hermes" "$SK/.hermes/profiles" "$SK/.hermes/profiles/android-stack" "$SK/.local/bin" "$RUN/stage/run-aegl" "$SK$(dirname "${GUARD_DEST#/home/zhong}")"

# --- in-sandbox runner -------------------------------------------------------- #
if [ -n "$CHECK_CMD" ]; then
  # no-model check: the SAME mounts and the SAME identity drop, no shim, no model call
  cat > "$RUN/sandbox-run.sh" <<EOF
#!/bin/bash
set -u
$CHECK_CMD
rc=\$?
printf 'SANDBOX_CHECK_RC=%s\n' "\$rc"
exit \$rc
EOF
  # the payload the DROPPED process runs must be exactly the verified check text
  grep -qF -- "$CHECK_CMD" "$RUN/sandbox-run.sh" \
    || die "check payload was not projected verbatim into the task-level runner"
else
cat > "$RUN/sandbox-run.sh" <<EOF
#!/bin/bash
python3 '$SHIM' --listen 127.0.0.1:$PORT --unix '$SOCK' >/dev/null 2>&1 &
shim=\$!; sleep 0.6
"\$@"; rc=\$?
kill \$shim 2>/dev/null
exit \$rc
EOF
fi
chmod 0755 "$RUN/sandbox-run.sh"

# --- bwrap spec (root mounts, no userns) + trusted drop entry ------------------ #
say "AEGL_HERMES_SANDBOX task=$TASK ai_uid=$AI_UID sandbox=on (private ns aliases; drop to aegl-ai BEFORE bwrap)"
SPEC="$RUN/spec.json"
# --- alias view: root binds the declared sources inside THIS task's private mount ns -- #
# aegl-ai cannot traverse the 0750 /home/zhong parents; the aliases live under a traversable
# task dir, so bwrap (running AS aegl-ai) can resolve them. Nothing is copied and the mounts
# exist only in this private namespace (never propagated to the host).
SRC="$RUN/src"; mkdir -p "$SRC/runtime" "$SRC/tools" "$SRC/guard" "$SRC/gen"; : > "$SRC/entry"
chmod 0755 "$SRC"; chown root:root "$SRC"

# --- task-level install state: SAME path Hermes expects, locks/leases writable --------- #
KEY="$(python3 -c 'import hashlib,sys;print(hashlib.sha256(sys.argv[1].encode()).hexdigest()[:16])' "$(realpath "$HERMES_RUNTIME")")"
GEN="$HERMES_HOME_REAL/installs/$KEY"
{ [ -d "$GEN" ] && [ -f "$GEN/facts.json" ]; } || die "no verified install generation at $GEN (refusing to fabricate one)"
VIEW="$RUN/installs"; mkdir -p "$VIEW/$KEY"
# the small mutable pieces are reused VERBATIM (facts, declined packages, inputs stamps,
# bootstrap cache, pm-runtime selection + locks) so every lock works in the writable view
for entry in facts.json declined-packages.json inputs bootstrap pm-runtime; do
  [ -e "$GEN/$entry" ] && cp -a "$GEN/$entry" "$VIEW/$KEY/$entry"
done
# the SELECTED generation is parsed from the real facts (never hardcoded): its .leases and
# .lease-managed must be writable, while venv/ + workspace/ are reused read-only
GENHASH="$(python3 -c 'import json,os,sys;d=json.load(open(sys.argv[1]));print(os.path.basename(os.path.dirname(d["packages"]["venv"]["environment"])))' "$VIEW/$KEY/facts.json")" || die "cannot parse the selected generation from facts.json"
GREAL="$GEN/environments/$GENHASH"; GVIEW="$VIEW/$KEY/environments/$GENHASH"
[ -d "$GREAL" ] || die "selected generation missing: $GREAL"
mkdir -p "$GVIEW/venv" "$GVIEW/workspace" "$GVIEW/.leases"
[ -f "$GREAL/.lease-managed" ] && cp -a "$GREAL/.lease-managed" "$GVIEW/.lease-managed"
chown -R "$AI_USER":"$AI_GROUP" "$VIEW"

# --- task-level android-stack profile: writable run state ----------------------------- #
PROF_REAL="$HERMES_HOME_REAL/profiles/android-stack"
PROFV="$RUN/profile"; mkdir -p "$PROFV/sessions" "$PROFV/logs" "$PROFV/runtime" \
  "$PROFV/terminal-sessions" "$PROFV/cache" "$PROFV/sandboxes" "$PROFV/skills" "$PROFV/hooks"
: > "$PROFV/state.db"; : > "$PROFV/config.yaml"          # mount points only
: > "$PROFV/SOUL.md"; : > "$PROFV/profile.yaml"
: > "$PROFV/shell-hooks-allowlist.json"                  # overwritten by ro-bind of task allowlist
chown -R "$AI_USER":"$AI_GROUP" "$PROFV"
# read-only PROJECTION of the declared instruction content: the host profile, skills and
# hooks are 0700, so a bind alias would stay unreadable after the drop. Copy ONLY these
# non-secret items into a task projection and grant a+rX (host sources untouched). No .env,
# credentials, history database, sessions or logs. The projection dies with the task dir.
PROJV="$RUN/proj"; mkdir -p "$PROJV"
for f in SOUL.md profile.yaml; do [ -f "$PROF_REAL/$f" ] && cp -p "$PROF_REAL/$f" "$PROJV/$f"; done
for d in skills hooks; do [ -d "$PROF_REAL/$d" ] && cp -a "$PROF_REAL/$d" "$PROJV/$d"; done
chown -R root:root "$PROJV"; chmod -R a+rX,o-w "$PROJV"

# --- home-level mutable run state (sessions/logs/cache) -------------------------------- #
ST="$RUN/runstate"; mkdir -p "$ST/home-sessions" "$ST/home-logs" "$ST/home-cache"
chown -R "$AI_USER":"$AI_GROUP" "$ST"


# --- Git metadata: real Git plus the trusted registration decide the paths, never the raw
# gitfile text. The shared metadata is mounted READ-ONLY; only THIS task's worktree admin
# gets a writable per-task view, and the host admin dir is never written. ----------------- #
GIT_MOUNTS=()
GIT_META_HELPER="$(pick git_meta_mounts.sh)"
[ -f "$GIT_META_HELPER" ] || die "git metadata helper missing: $GIT_META_HELPER"
GIT_MOUNTS_RAW="$(/bin/bash "$GIT_META_HELPER" "$WT_R" "$RUN/gitadmin" "$PROJ" ${CHECK_BASELINE:+--baseline})" \
  || die "git metadata mapping failed for $WT_R"
while IFS= read -r m; do [ -n "$m" ] && GIT_MOUNTS+=("$m"); done <<< "$GIT_MOUNTS_RAW"
say "  git metadata: ${#GIT_MOUNTS[@]} mount(s)${CHECK_BASELINE:+ (baseline: intentionally none)}"

MOUNTS=()
# install state (writable view is a fixed spec element); the generation content is read-only
for d in venv workspace; do
  MOUNTS+=("ro-bind:$SRC/gen/environments/$GENHASH/$d:/home/zhong/.hermes/installs/$KEY/environments/$GENHASH/$d")
done
# the profile dir is the writable task view; the trusted config, projected
# instruction files, and the task-local shell-hooks allowlist are mounted read-only
# OVER it (the model cannot edit config, hooks, or approvals). hermes -p android-stack
# sets HERMES_HOME to this profile dir, so allowlist_path() resolves here.
MOUNTS+=("bind:$PROFV:/home/zhong/.hermes/profiles/android-stack")
MOUNTS+=("ro-bind:$SK/.hermes/config.yaml:/home/zhong/.hermes/profiles/android-stack/config.yaml")
MOUNTS+=("ro-bind:$ALLOWLIST_SRC:/home/zhong/.hermes/profiles/android-stack/shell-hooks-allowlist.json")
for f in SOUL.md profile.yaml; do
  MOUNTS+=("ro-bind:$PROJV/$f:/home/zhong/.hermes/profiles/android-stack/$f")
done
for d in skills hooks; do
  MOUNTS+=("ro-bind:$PROJV/$d:/home/zhong/.hermes/profiles/android-stack/$d")
done
MOUNTS+=("bind:$ST/home-sessions:/home/zhong/.hermes/sessions")
MOUNTS+=("bind:$ST/home-logs:/home/zhong/.hermes/logs")
MOUNTS+=("bind:$ST/home-cache:/home/zhong/.hermes/cache")
MOUNT_ARGS=(); for m in "${MOUNTS[@]}"; do MOUNT_ARGS+=(--mount "$m"); done
for m in "${GIT_MOUNTS[@]}"; do MOUNT_ARGS+=(--mount "$m"); done

python3 "$SPEC_PY" --bwrap "$BWRAP" --uid "$AI_UID" --gid "$AI_GID" --run "$RUN" \
  --wt "$WT_R" --scr "$SCR_R" --runtime "$SRC/runtime" --tools "$SRC/tools" \
  --entry "$SRC/entry" --installs-view "$VIEW" "${MOUNT_ARGS[@]}" --guard-src "$SRC/guard" \
  --guard-dest "$GUARD_DEST" --contract-package "$CONTRACT" \
  ${INFO_FD:+--info-fd "$INFO_FD"} -- "${HERMES_ARGS[@]}" > "$SPEC" || die "spec build failed"
# nothing the dropped identity can see may point at the root-exclusive package
if grep -q '/root/' "$SPEC"; then die "sandbox spec references /root (refusing to expose it)"; fi
# create EVERY mount target under the read-only skeleton, derived from the ACTUAL argv
python3 "$PREPARE" "$SPEC" "$SK" || die "mount-target preparation failed"
chown -R root:"$AI_GROUP" "$RUN/stage"; chmod -R g+rX,o-rwx "$RUN/stage"
chmod 0755 "$SK" "$SK/.hermes" "$SK/.local/bin"

# --- trusted root prep: private ns + aliases, then drop to host aegl-ai BEFORE bwrap ---- #
# bwrap starts as aegl-ai (non-setuid) and uses its AppArmor-permitted user namespace; there
# is NO capability-requiring identity switch inside bwrap.
# --- post-drop entry projection: the dropped identity must READ what it runs ------------- #
# prep.sh execs these AFTER setpriv to aegl-ai, so they cannot live in the root-exclusive
# package. Project ONLY these two stdlib-only entries into this run's trusted control dir,
# verify the content against the frozen payload, then drop. root owns it; aegl-ai may read
# and traverse it but cannot write it.
CTL="$RUN/ctl"; mkdir -p "$CTL"
project() { # <src> -> resolved projected path
  local src="$1" name
  name="$(basename "$src")"
  [ -f "$src" ] || die "post-drop entry missing: $src"
  install -o root -g root -m 0644 "$src" "$CTL/$name.new" || die "projection copy $name"
  [ "$(sha256sum "$src" | awk '{print $1}')" = "$(sha256sum "$CTL/$name.new" | awk '{print $1}')" ] \
    || die "projection mismatch $name"
  mv -f "$CTL/$name.new" "$CTL/$name" || die "projection swap $name"
  readlink -f "$CTL/$name"
}
CTL_DROP_VERIFY="$(project "$DROP_VERIFY")"
CTL_EXEC_SPEC="$(project "$EXEC_SPEC")"
chown -R root:root "$CTL"; chmod 0755 "$CTL"; chmod 0644 "$CTL"/*
chmod 0644 "$SPEC"
say "  post-drop entries (projected from the frozen payload, content verified):"
say "    drop_verify=$CTL_DROP_VERIFY sha=$(sha256sum "$CTL_DROP_VERIFY" | awk '{print $1}') owner=$(stat -c '%U:%G %a' "$CTL_DROP_VERIFY")"
say "    exec_spec=$CTL_EXEC_SPEC sha=$(sha256sum "$CTL_EXEC_SPEC" | awk '{print $1}') owner=$(stat -c '%U:%G %a' "$CTL_EXEC_SPEC")"

cat > "$RUN/prep.sh" <<EOF
#!/bin/bash
set -e
mount --make-rprivate /
mount --bind '$HERMES_RUNTIME' '$SRC/runtime'
mount --bind '$HERMES_TOOLS' '$SRC/tools'
mount --bind '$HERMES_ENTRY' '$SRC/entry'
mount --bind '$GEN' '$SRC/gen'
mount --bind '$GUARD_SRC' '$SRC/guard'
exec '$SETPRIV' --reuid '$AI_UID' --regid '$AI_GID' --clear-groups --no-new-privs \
  --bounding-set=-all --inh-caps=-all --ambient-caps=-all -- \\
  python3 '$CTL_DROP_VERIFY' --uid '$AI_UID' --gid '$AI_GID' -- \\
  python3 '$CTL_EXEC_SPEC' '$SPEC'
EOF
chown root:root "$RUN/prep.sh"; chmod 0755 "$RUN/prep.sh"
if grep -q '/root/' "$RUN/prep.sh"; then
  die "prep.sh would hand a /root path to the dropped identity"
fi
say "  prep.sh post-drop command:"
sed -n '/^exec /,$p' "$RUN/prep.sh" | sed 's/^/    /'
# --- the real chain runs UNDER strace; the credential broker stays OUTSIDE the traced branch
# only file open/create results and errnos are captured (no network, buffers, credentials, env)
diag_ev --phase sandbox_prep_done --task "$TASK"
diag_ev --phase launch_requested --task "$TASK"
TRACE_LOG="${AEGL_TRIAL_EVIDENCE:-$RUN}/strace.log"
if [ -n "${AEGL_TRIAL_EVIDENCE:-}" ] && [ -x /usr/bin/strace ]; then
  say "  tracing the sandbox tool branch -> $TRACE_LOG"
  /usr/bin/strace -f -q -s 256 -e trace=openat,open,creat -o "$TRACE_LOG" \
    unshare --mount --propagation private -- bash "$RUN/prep.sh"
else
  say "  NOTE: no controller evidence dir or strace unavailable; the branch is NOT traced"
  unshare --mount --propagation private -- bash "$RUN/prep.sh"
fi
rc=$?
kill "$BPID" 2>/dev/null
exit "$rc"
