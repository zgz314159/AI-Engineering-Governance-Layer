#!/usr/bin/env bash
# aegl-hermes-sandbox — run real Hermes (and its tool subprocesses) as the AI identity
# (aegl-ai), reaching the existing provider ONLY through the trusted model broker.
#
#   sudo aegl-hermes-sandbox --task <id> [--info-fd N] -- hermes ...
#
# /home/zhong is 0750 zhong:zhong, so the AI uid cannot traverse it. Two-phase mounting:
# a root helper (recovery/bind_fd_exec.py) OPENS each declared source with a file
# descriptor and execs bwrap with --ro-bind-fd, so the source is never re-resolved inside
# the sandbox user namespace. Inside, /home/zhong is a traversable skeleton carrying only
# the declared runtime + the task config; the real HOME/.hermes are not exposed. Host
# HOME/project permissions are NOT changed. --info-fd is forwarded to bwrap so a caller
# can obtain the actual child process for trusted uid/namespace evidence.
set -uo pipefail

BWRAP="/usr/bin/bwrap"
AI_USER="${AEGL_AI_USER:-aegl-ai}"
TRUSTED_TASK_REGISTRY="${AEGL_MODEL_TASK_REGISTRY:-/var/lib/aegl-model/registry.json}"
CONFIG="${AEGL_MODEL_CONFIG:-/etc/aegl/model/config}"
LIBDIR="${AEGL_MODEL_LIBDIR:-/usr/local/lib/aegl-model}"
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BROKER_BIN="$LIBDIR/aegl-model-broker"; [ -x "$BROKER_BIN" ] || BROKER_BIN="$SELF_DIR/aegl-model-broker"
SHIM="$LIBDIR/loopback_shim.py";         [ -f "$SHIM" ] || SHIM="$SELF_DIR/../recovery/loopback_shim.py"
FD_EXEC="$LIBDIR/bind_fd_exec.py";       [ -f "$FD_EXEC" ] || FD_EXEC="$SELF_DIR/../recovery/bind_fd_exec.py"

say(){ printf '%s\n' "$*"; }
die(){ printf 'BLOCKED: %s\n' "$*" >&2; exit 1; }

TASK=""; INFO_FD=""; HERMES_ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --task) TASK="${2:-}"; shift 2 ;;
    --info-fd) INFO_FD="${2:-}"; shift 2 ;;
    --) shift; HERMES_ARGS=("$@"); break ;;
    *) die "unknown option: $1" ;;
  esac
done
[ "$(id -u)" = 0 ] || die "must run as root (to prepare mounts and drop to $AI_USER)"
case "$TASK" in ""|*[!A-Za-z0-9._-]*) die "restricted task_id required" ;; esac
[ "${#TASK}" -le 64 ] || die "task_id too long"
[ -f "$CONFIG" ] || die "trusted config not found: $CONFIG"
[ -x "$BWRAP" ] || die "sandbox backend absent"
[ -f "$FD_EXEC" ] || die "bind_fd_exec.py not found"
# shellcheck disable=SC1090
. "$CONFIG"
for v in UPSTREAM CREDENTIAL_ENV CREDENTIAL_SOURCE HERMES_ENTRY HERMES_RUNTIME HERMES_TOOLS HERMES_INSTALLS HERMES_HOME_REAL HERMES_PROFILE_CONFIG; do
  [ -n "${!v:-}" ] || die "trusted config missing $v"
done
AI_UID="$(id -u "$AI_USER")"; AI_GID="$(id -g "$AI_USER")"; AI_GROUP="$(id -gn "$AI_USER")"

# --- trusted task registry (root-owned; NOT the AI-writable task.json) -------- #
[ -f "$TRUSTED_TASK_REGISTRY" ] || die "trusted task registry not found: $TRUSTED_TASK_REGISTRY"
read -r WT SCR_R PROJ < <(python3 - "$TRUSTED_TASK_REGISTRY" "$TASK" <<'PY'
import json, sys
reg = json.load(open(sys.argv[1], encoding="utf-8"))
e = reg.get(sys.argv[2], {})
print(e.get("worktree", ""), e.get("scratch", ""), e.get("project", ""))
PY
)
[ -n "$WT" ] && [ -n "$SCR_R" ] || die "task not in the trusted registry: $TASK"
WT_R="$(realpath -e "$WT")" || die "worktree missing"
SCR_R="$(realpath -e "$SCR_R")" || die "scratch missing"
for p in "$WT_R" "$SCR_R"; do
  case "$p" in /tmp/*|/var/tmp/*|/run/aegl-*/*|/var/lib/aegl-*/*) : ;; *) die "task path outside the allowed bases: $p" ;; esac
done
[ "$(stat -c '%U' "$WT_R")" = "$AI_USER" ] || die "worktree not owned by $AI_USER"

# --- run dir (root-owned) + traversable /home/zhong skeleton ------------------ #
RUN="/run/aegl-model/$TASK"; rm -rf "$RUN"
mkdir -p "$RUN/broker" "$RUN/home" \
         "$RUN/stage/home-zhong/.hermes" "$RUN/stage/home-zhong/.local/bin" "$RUN/stage/run-aegl"
chown root:"$AI_GROUP" "$RUN"; chmod 0755 "$RUN"
chown root:"$AI_GROUP" "$RUN/broker"; chmod 0750 "$RUN/broker"
chown "$AI_USER":"$AI_GROUP" "$RUN/home"; chmod 0750 "$RUN/home"
chown -R root:root "$RUN/stage"; chmod -R a+rX,o-w "$RUN/stage"
chmod 0755 "$RUN/stage/home-zhong/.hermes" "$RUN/stage/home-zhong/.local/bin" "$RUN/stage/run-aegl"
SOCK="$RUN/broker/model.sock"; PORT=8877

# --- trusted broker: credential read as DATA from its ORIGINAL location ------- #
AEGL_MODEL_SOCKET="$SOCK" AEGL_MODEL_UPSTREAM="$UPSTREAM" \
AEGL_MODEL_CREDENTIAL_ENV="$CREDENTIAL_ENV" AEGL_MODEL_CREDENTIAL_SOURCE="$CREDENTIAL_SOURCE" \
  "$BROKER_BIN" serve >"$RUN/broker.log" 2>&1 &
BPID=$!
trap 'kill "$BPID" 2>/dev/null' EXIT
for _ in $(seq 1 60); do [ -S "$SOCK" ] && break; sleep 0.1; done
[ -S "$SOCK" ] || die "model broker did not start (see $RUN/broker.log)"
chown root:"$AI_GROUP" "$SOCK"; chmod 0660 "$SOCK"

# --- task HERMES_HOME config: model endpoint + the ORIGINAL hooks (guard) ----- #
[ -f "$HERMES_PROFILE_CONFIG" ] || die "guard source config missing: $HERMES_PROFILE_CONFIG"
grep -q '^hooks:' "$HERMES_PROFILE_CONFIG" || die "guard config has no hooks block; refusing (no guard)"
python3 - "$HERMES_PROFILE_CONFIG" "$RUN/stage/home-zhong/.hermes/config.yaml" "$PORT" <<'PY' || die "config build failed"
import sys
src, dst, port = sys.argv[1], sys.argv[2], sys.argv[3]
keep, on = [], False
for line in open(src, encoding="utf-8").read().splitlines():
    if line.startswith("hooks:"):
        on = True; keep.append(line); continue
    if on:
        if line and not line[0].isspace():
            on = False
        else:
            keep.append(line)
with open(dst, "w", encoding="utf-8") as fh:
    fh.write("model:\n  provider: custom\n  base_url: http://127.0.0.1:%s/v1\n"
             "  api_key: aegl-sandbox-dummy\n  default: deepseek/deepseek-v4.1-flash\n" % port)
    fh.write("\n".join(keep).rstrip() + "\n")
PY
: > "$RUN/stage/empty"; chmod 0644 "$RUN/stage/empty"
chown -R root:"$AI_GROUP" "$RUN/stage"; chmod -R g+rX,o-rwx "$RUN/stage"
chmod 0755 "$RUN/stage/home-zhong" "$RUN/stage/home-zhong/.hermes" "$RUN/stage/home-zhong/.local/bin" "$RUN/stage/run-aegl"

# --- in-sandbox runner: start the shim, then exec the command ----------------- #
cat > "$RUN/sandbox-run.sh" <<EOF
#!/bin/bash
python3 '$SHIM' --listen 127.0.0.1:$PORT --unix '$SOCK' >/dev/null 2>&1 &
shim=\$!; sleep 0.6
"\$@"; rc=\$?
kill \$shim 2>/dev/null
exit \$rc
EOF
chmod 0755 "$RUN/sandbox-run.sh"

# --- two-phase bwrap: root opens /home/zhong sources by fd, then drops -------- #
say "AEGL_HERMES_SANDBOX task=$TASK ai_uid=$AI_UID sandbox=on (two-phase fd mounts)"
SPEC="$RUN/spec.json"
python3 - "$SPEC" "$BWRAP" "$AI_UID" "$AI_GID" "$RUN" "$WT_R" "$SCR_R" "$INFO_FD" \
  "$HERMES_RUNTIME" "$HERMES_TOOLS" "$HERMES_ENTRY" "$HERMES_INSTALLS" "${HERMES_ARGS[@]}" <<'PY'
import json, sys
out, bwrap, uid, gid, run, wt, scr, info_fd = sys.argv[1:9]
runtime, tools, entry, installs = sys.argv[9:13]
hermes = sys.argv[13:]
argv = [bwrap, "--unshare-all", "--uid", uid, "--gid", gid, "--dev", "/dev", "--proc", "/proc",
        "--ro-bind", "/", "/",
        "--ro-bind", run + "/stage/home-zhong", "/home/zhong",
        {"bind_fd": "runtime", "dest": "/home/zhong/.hermes/hermes-agent"},
        {"bind_fd": "tools", "dest": "/home/zhong/.hermes/tools"},
        {"bind_fd": "entry", "dest": "/home/zhong/.local/bin/hermes"},
        "--ro-bind", run + "/stage/run-aegl", "/run/aegl-run",
        {"bind_fd": "installs", "dest": "/run/aegl-run/installs-ro"},
        "--overlay-src", "/run/aegl-run/installs-ro", "--tmp-overlay", "/home/zhong/.hermes/installs",
        "--ro-bind", run + "/stage/home-zhong/.hermes/config.yaml", "/home/zhong/.hermes/config.yaml",
        "--tmpfs", "/home/zhong/.hermes/profiles", "--tmpfs", "/home/zhong/.hermes/sessions",
        "--ro-bind", run + "/stage/empty", "/home/zhong/.hermes/.env",
        "--bind", run + "/home", run + "/home",
        "--clearenv", "--setenv", "PATH", "/usr/local/bin:/usr/bin:/bin:/home/zhong/.local/bin",
        "--setenv", "HOME", run + "/home", "--setenv", "HERMES_HOME", "/home/zhong/.hermes",
        "--setenv", "TMPDIR", scr, "--setenv", "AEGL_AI_SANDBOX", "1"]
if info_fd:
    argv += ["--info-fd", info_fd]
argv += ["--die-with-parent", "--chdir", wt, "bash", run + "/sandbox-run.sh"] + list(hermes)
json.dump({"fds": {"runtime": runtime, "tools": tools, "entry": entry, "installs": installs},
           "info_fd": info_fd, "argv": argv}, open(out, "w", encoding="utf-8"))
PY
python3 "$FD_EXEC" < "$SPEC"
rc=$?
kill "$BPID" 2>/dev/null
exit "$rc"
