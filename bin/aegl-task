#!/usr/bin/env bash
# AEGL task boundary — boundary audit | boundary rulesync deploy | task start|verify|promote|discard
#                       | controller probe (trusted-controller only)
#
# AI work runs ONLY inside a disposable worktree created outside the project under
# the AEGL XDG state root, under an OS sandbox (bubblewrap) that is fail-closed:
#   * the whole task process tree runs inside the sandbox (no unsandboxed execution),
#   * the canonical projects are read-only,
#   * host credential paths are masked (unreadable),
#   * the environment is a fixed whitelist (`--clearenv` + explicit --setenv).
# A promotion gate RE-CLASSIFIES the candidate content at promote time and requires
# it to be byte-identical to what was verified (no "modified after verify"), covering
# untracked and ignored files. Only the trusted controller applies the diff.
set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AEGL_ROOT="$(cd "$SELF_DIR/.." && pwd)"
PROJECTS_ROOT="${PROJECTS_ROOT:-$(cd "$AEGL_ROOT/.." && pwd)}"
TASKS_ROOT="${AEGL_TASKS_ROOT:-${AEGL_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/aegl}/tasks}"

BWRAP="${BWRAP:-/usr/bin/bwrap}"
SANDBOX_PATH="${SANDBOX_PATH:-$HOME/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin}"

have() { command -v "$1" >/dev/null 2>&1; }
say() { printf '%s\n' "$*"; }
die() { printf 'BLOCKED: %s\n' "$*" >&2; exit 1; }

resolve_project() {
  local p="$1"
  case "$p" in
    /*) [ -d "$p" ] && { printf '%s' "$p"; return; } ;;
    *) [ -d "$PROJECTS_ROOT/$p" ] && { printf '%s' "$PROJECTS_ROOT/$p"; return; } ;;
  esac
  die "unknown project: $p"
}
task_dir() { printf '%s' "$TASKS_ROOT/$1"; }
task_field() { python3 -c "import json,sys;print(json.load(open(sys.argv[1])).get(sys.argv[2],''))" "$1" "$2"; }

# --------------------------------------------------------------------------- #
# sandbox (fail closed; whole task tree inside; credentials masked; env whitelisted)
# --------------------------------------------------------------------------- #
# Host credential paths that must be UNREADABLE inside the sandbox.
MASK_DIRS=(.ssh .aws .gnupg .config .commandcode .hermes .local/share/keyrings .docker .kube .password-store .mozilla)
MASK_FILES=(.netrc .git-credentials .bash_history .zsh_history .python_history .pgpass .npmrc)

sandbox_run() { # sandbox_run <worktree> <scratch> <gradle_home> <cmd...>
  local wt="$1" scratch="$2" gh="$3"; shift 3
  [ -x "$BWRAP" ] || die "sandbox backend absent ($BWRAP) — refusing to run unsandboxed"
  mkdir -p "$scratch/home" "$scratch/tmp" "$gh"
  local args=( --ro-bind / / --dev /dev --proc /proc
               --bind "$wt" "$wt" --bind "$scratch" "$scratch" --bind "$gh" "$gh" )
  # mask credentials (make unreadable)
  local p
  for p in "${MASK_DIRS[@]}"; do  [ -d "$HOME/$p" ] && args+=( --tmpfs "$HOME/$p" ); done
  for p in "${MASK_FILES[@]}"; do [ -e "$HOME/$p" ] && args+=( --ro-bind /dev/null "$HOME/$p" ); done
  # mask the controller token so a sandboxed process can never read it
  local _tf="${AEGL_CONTROLLER_TOKEN_FILE:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/aegl-controller.token}"
  [ -e "$_tf" ] && args+=( --ro-bind /dev/null "$_tf" )
  # fixed environment whitelist (no inherited env)
  args+=( --clearenv
          --setenv PATH "$SANDBOX_PATH"
          --setenv HOME "$scratch/home"
          --setenv TMPDIR "$scratch/tmp"
          --setenv GRADLE_USER_HOME "$gh"
          --setenv LANG "${LANG:-C.UTF-8}"
          --setenv USER sandbox
          --setenv MISE_DATA_DIR "${MISE_DATA_DIR:-$HOME/.local/share/mise}"
          --setenv MISE_CACHE_DIR "${MISE_CACHE_DIR:-$HOME/.cache/mise}"
          --unshare-all --die-with-parent --chdir "$wt" )
  "$BWRAP" "${args[@]}" "$@"
}

# manifest of the whole candidate worktree (incl. untracked/ignored), excluding .git
worktree_manifest() { # <worktree> <outfile>
  ( cd "$1" && find . -name .git -prune -o -type f -print0 2>/dev/null | sort -z | xargs -0 -r sha256sum 2>/dev/null ) > "$2"
}

# --------------------------------------------------------------------------- #
# boundary audit  (returns non-zero when a violation is found)
# --------------------------------------------------------------------------- #
boundary_audit() {
  local bad=0
  say "AEGL BOUNDARY AUDIT (read-only)"
  say "tasks_root=$TASKS_ROOT"
  say "sandbox=$BWRAP ($( "$BWRAP" --version 2>/dev/null || echo missing))"
  [ -x "$BWRAP" ] || { say "  sandbox missing"; bad=$((bad+1)); }
  for p in Google-Android-Agent-Development-Stack KeepLab-Relay AI-Engineering-Governance-Layer; do
    local d="$PROJECTS_ROOT/$p"
    [ -d "$d" ] || { say "  MISSING project: $p"; bad=$((bad+1)); continue; }
    local dirty; dirty="$(git -C "$d" status --porcelain 2>/dev/null | grep -vE '^ M references/' | wc -l)"
    say "  $p: git=$([ -d "$d/.git" ] && echo yes || echo no) dirty=$dirty"
  done
  if [ -f "$PROJECTS_ROOT/Google-Android-Agent-Development-Stack/scripts/verify-layout.sh" ]; then
    local v; v="$(bash "$PROJECTS_ROOT/Google-Android-Agent-Development-Stack/scripts/verify-layout.sh" --root "$PROJECTS_ROOT/Google-Android-Agent-Development-Stack" 2>&1 | tail -1)"
    say "  stack layout: $v"
    case "$v" in *violations=0*) : ;; *) say "  layout violations present"; bad=$((bad+1));; esac
  fi
  local rsp; rsp="$(python3 -c "import json;print(json.load(open('$AEGL_ROOT/versions.json'))['ruleSync']['ref'])" 2>/dev/null)"
  say "  rulesync pin: $rsp"
  if grep -rIl 'ruler' "$AEGL_ROOT/governance" "$AEGL_ROOT/bridge" "$AEGL_ROOT/scripts" "$AEGL_ROOT/core" 2>/dev/null | grep -q .; then
    say "  ruler: PRESENT (unexpected)"; bad=$((bad+1))
  else say "  ruler: absent (RuleSync only)"; fi
  say "BOUNDARY_AUDIT_BAD=$bad"
  [ "$bad" -eq 0 ]
}

# --------------------------------------------------------------------------- #
# RuleSync: PLAN + dry-run diff ONLY — never writes, never overwrites/deletes.
# Capability paths are pinned to the reviewed v25 rules adapters. Cursor has no
# global rules path; project AGENTS.md/CLAUDE.md files are not deployment targets.
# --------------------------------------------------------------------------- #
RULESYNC_TARGETS=(claudecode codexcli cursor)
rulesync_global_support() { # <target> -> yes|no|unknown (from pinned v25 docs)
  case "$1" in
    claudecode|codexcli) echo yes ;;   # doc: ✅ 🌏  (rules support global mode)
    cursor)              echo no  ;;   # doc: ✅    (rules are project-scope only)
    *)                   echo unknown ;;
  esac
}
rulesync_global_file() { # <target> -> path relative to the operator home
  case "$1" in
    claudecode) echo ".claude/CLAUDE.md" ;;
    codexcli)   echo ".codex/AGENTS.md" ;;
  esac
}

rulesync_plan() {
  local source="$AEGL_ROOT/governance/global-agent-policy.md"
  say "RULESYNC PLAN (dry-run; writes nothing)"
  say "  policy source: $source"
  local unsupported=0 conflicts=0 missing=0 t f dest
  [ -f "$source" ] || { say "  policy source missing"; missing=1; }
  for t in "${RULESYNC_TARGETS[@]}"; do
    local g; g="$(rulesync_global_support "$t")"
    say "  target=$t global_rules=$g"
    if [ "$g" != yes ]; then
      say "    -> global rules NOT supported: target NOT_DONE"
      unsupported=$((unsupported+1))
      continue
    fi
    f="$(rulesync_global_file "$t")"; dest="$HOME/$f"
    if [ -e "$dest" ] || [ -L "$dest" ]; then
      local h; h="$(sha256sum "$dest" 2>/dev/null | awk '{print $1}')"
      say "    would write: $dest  EXISTS sha256=${h:-unreadable}  CONFLICT (never overwrite automatically)"
      conflicts=$((conflicts+1))
    else
      say "    would write: $dest  (absent)"
    fi
  done
  say "  conflicts=$conflicts unsupported_targets=$unsupported missing_source=$missing"
  if [ "$unsupported" -gt 0 ] || [ "$conflicts" -gt 0 ] || [ "$missing" -gt 0 ]; then
    say "RULESYNC_PLAN=NOT_DONE (unsupported targets, conflicts, or missing source; nothing written)"
    return 1
  fi
  say "RULESYNC_PLAN=OK (no conflicts; a deploy may be proposed for operator approval)"
}

# --------------------------------------------------------------------------- #
# task start
# --------------------------------------------------------------------------- #
task_start() {
  local proj name
  proj="$(resolve_project "${1:?task start <project> <name>}")"; name="${2:?name required}"
  case "$name" in *[!A-Za-z0-9._-]*) die "name must be [A-Za-z0-9._-]" ;; esac
  [ -d "$proj/.git" ] || die "project is not a git baseline: $proj"
  git -C "$proj" rev-parse HEAD >/dev/null 2>&1 || die "no baseline commit in $proj"
  local id="$name-$(date +%s)"; local td; td="$(task_dir "$id")"; local wt="$td/worktree"
  mkdir -p "$td" "$td/scratch" "$td/gradle-home"
  git -C "$proj" worktree add -q -b "aegl-task/$name" "$wt" HEAD || die "worktree create failed"
  python3 - "$td/task.json" "$id" "$proj" "$name" "$wt" "$td/scratch" "$td/gradle-home" "$(git -C "$proj" rev-parse HEAD)" <<'PY'
import json,sys
p,id_,proj,name,wt,scratch,gh,base=sys.argv[1:9]
json.dump({"id":id_,"project":proj,"name":name,"worktree":wt,"scratch":scratch,
           "gradle_home":gh,"base":base,"branch":f"aegl-task/{name}"}, open(p,"w"), indent=2)
PY
  say "TASK_STARTED id=$id"; say "  worktree=$wt"; say "  scratch=$td/scratch"
}

# --------------------------------------------------------------------------- #
# sandboxed task execution (shared by task verify and the trusted controller)
# --------------------------------------------------------------------------- #
_verify_paths() { td="$(task_dir "$1")"; [ -f "$td/task.json" ] || die "no such task: $1"
  wt="$(task_field "$td/task.json" worktree)"; scratch="$(task_field "$td/task.json" scratch)"
  gh="$(task_field "$td/task.json" gradle_home)"; proj="$(task_field "$td/task.json" project)"; }

_run_sandboxed() { # <id> <cmd>  -> writes $td/verify.log, verify.manifest, verify.status
  local id="$1" cmd="$2" td wt scratch gh proj
  _verify_paths "$id"
  # sandbox smoke + credential/env assertions, fail closed.
  # Host paths are expanded by the CONTROLLER here, then evaluated inside the sandbox.
  local smoke
  # canonical read-only (11), credential masked (12), env whitelist present (13)
  smoke="set -e; echo ok > \"\$TMPDIR/probe\"; [ ! -w '$PROJECTS_ROOT' ] || exit 11; [ ! -r '$HOME/.commandcode/auth.json' ] || exit 12; env | grep -q '^PATH=' || exit 13; echo SANDBOX_OK"
  sandbox_run "$wt" "$scratch" "$gh" bash -c "$smoke" >"$td/sandbox-smoke.log" 2>&1 \
    || { grep -q SANDBOX_OK "$td/sandbox-smoke.log" || die "sandbox smoke failed (see $td/sandbox-smoke.log)"; }
  grep -q SANDBOX_OK "$td/sandbox-smoke.log" || die "sandbox smoke failed (see $td/sandbox-smoke.log)"
  local rc=0
  sandbox_run "$wt" "$scratch" "$gh" bash -lc "$cmd" >"$td/verify.log" 2>&1 || rc=$?
  worktree_manifest "$wt" "$td/verify.manifest"
  if [ "$rc" = 0 ]; then printf 'PASS\n' > "$td/verify.status"; else printf 'FAIL\n' > "$td/verify.status"; fi
  return "$rc"
}

# task verify — the AI-facing action. The test command is the PROJECT's declared task
# only; no caller-supplied override is honoured here.
task_verify() {
  local id="${1:?task verify <id>}" td wt
  _verify_paths "$id"
  local cmd
  if [ -f "$wt/mise.toml" ] && have mise; then cmd='mise run test'
  else
    case "$(basename "$proj")" in
      KeepLab-Relay) cmd='./gradlew -p backend test build --no-daemon --console=plain' ;;
      *)             cmd='bash scripts/run-tests.sh --root "$PWD"' ;;
    esac
  fi
  say "TASK_VERIFY sandbox=on id=$id"
  _run_sandboxed "$id" "$cmd" || { say "TASK_VERIFY=FAIL (tests rc)"; return 1; }
  local nrej; nrej="$(classify "$id" "$td/verify-changes.json" | tail -1)"
  say "TASK_VERIFY rejected_changes=$nrej"
  say "TASK_VERIFY=PASS"
}

# Trusted-controller authentication. A bare env flag is NOT identity: the caller must
# present the contents of an operator-owned token file (mode 600). That file is masked
# inside the sandbox, so the sandboxed AI can never read it or reproduce the token.
#
# Precise blocker (documented, not claimed fixed): within a single uid there is no
# kernel-enforced boundary between the operator and any other same-uid process, so
# token possession alone is not strong authentication. Enforcing it requires a
# separate uid / privileged broker (out of reach without privilege).
_controller_token_file() { printf '%s' "${AEGL_CONTROLLER_TOKEN_FILE:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/aegl-controller.token}"; }

controller_auth() {
  local tf; tf="$(_controller_token_file)"
  [ -f "$tf" ] || { printf 'BLOCKED: controller token file missing (%s); create it mode 600 with an operator secret\n' "$tf" >&2; return 1; }
  [ -n "${AEGL_CONTROLLER_TOKEN:-}" ] || { printf 'BLOCKED: AEGL_CONTROLLER_TOKEN not presented\n' >&2; return 1; }
  python3 -c 'import hmac,sys
a=open(sys.argv[1],"rb").read().strip(); b=sys.argv[2].encode()
sys.exit(0 if hmac.compare_digest(a,b) else 1)' "$tf" "$AEGL_CONTROLLER_TOKEN" \
    || { printf 'BLOCKED: controller token mismatch\n' >&2; return 1; }
  return 0
}

# --------------------------------------------------------------------------- #
# Independent operator broker (default-deny; no environment bypass).
#
# A same-UID token is NOT an identity boundary, and neither a socket *path* nor a
# socket's *owner* proves a broker is authorized. Promotion is refused unless a real
# broker at AEGL_BROKER_SOCKET answers a challenge handshake and is owned by a
# different uid. Omitting or setting any environment variable cannot re-enable it.
# --------------------------------------------------------------------------- #
BROKER_PROTOCOL="AEGL-BROKER/1"

# verify_broker <sock> -> 0 only if a broker completes the challenge handshake
verify_broker() {
  local sock="$1" nonce
  nonce="$(od -An -N8 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n')"
  [ -n "$nonce" ] || nonce="nonce$$"
  python3 - "$sock" "$nonce" "$BROKER_PROTOCOL" <<'PY'
import socket,sys
sock,nonce,proto=sys.argv[1],sys.argv[2],sys.argv[3]
expect=("%s PONG %s"%(proto,nonce)).encode()
try:
    s=socket.socket(socket.AF_UNIX); s.settimeout(2.0); s.connect(sock)
    s.sendall(("%s PING %s\n"%(proto,nonce)).encode())
    s.shutdown(socket.SHUT_WR)
    data=b""
    while len(data) < 4096:
        chunk=s.recv(4096)
        if not chunk: break
        data += chunk
        if b"\n" in data: break
except Exception:
    sys.exit(1)
sys.exit(0 if data.strip()==expect else 1)
PY
}

# identity_probe -> prints a classification; returns 0 only for VERIFIED broker
identity_probe() {
  local sock="${AEGL_BROKER_SOCKET:-}"
  [ -n "$sock" ] || { say "BROKER=NOT_AVAILABLE (no candidate socket configured)"; return 1; }
  [ -S "$sock" ] || { say "BROKER=NOT_AVAILABLE (not a socket: $sock)"; return 1; }
  local owner; owner="$(stat -c '%u' "$sock" 2>/dev/null)"
  say "CANDIDATE_SOCKET ($sock owner_uid=${owner:-unknown})"
  if [ "$owner" = "$(id -u)" ]; then
    say "BROKER=REJECTED (candidate owned by our own uid; a same-uid socket is never independent)"; return 1
  fi
  if verify_broker "$sock"; then
    say "BROKER=VERIFIED (candidate completed the $BROKER_PROTOCOL handshake)"; return 0
  fi
  say "BROKER=REJECTED (candidate did not complete the $BROKER_PROTOCOL handshake; owner alone does not authorize)"; return 1
}
identity_status() { identity_probe; }

# promotion requires a verified broker; there is no opt-out environment variable
require_broker() {
  identity_probe >&2 || die "promotion requires a VERIFIED independent broker (socket path/owner is not authorization; no env bypass)"
}

# trusted-controller primitive: run an arbitrary command in the sandbox for a task.
# It is NOT an AI entry (`bin/aegl-ai` is) and requires token authentication.
controller_probe() {
  controller_auth || die "controller probe authentication failed"
  local id="${1:?controller probe <id> <cmd>}"; shift
  local td wt scratch gh proj
  _verify_paths "$id"
  sandbox_run "$wt" "$scratch" "$gh" bash -lc "$1"
}

# --------------------------------------------------------------------------- #
# classification (fresh) — delegated to the ONE central gate (promotion_core.py)
# so the promotion rules are never duplicated here.
# --------------------------------------------------------------------------- #
classify() { # <id> <outfile>  -> prints rejected count (last line)
  local id="$1" out="$2" td wt scratch gh proj
  _verify_paths "$id"
  python3 "$AEGL_ROOT/recovery/promotion_core.py" classify "$wt" "$out"
}

# --------------------------------------------------------------------------- #
# bounded broker call — a request carries op + task_id only (requester ops); the
# requester never supplies a shell command or a target path. Returns the client rc.
# --------------------------------------------------------------------------- #
broker_call() { # <request-json>
  python3 "$AEGL_ROOT/recovery/promotion_broker.py" client \
      --socket "${AEGL_BROKER_SOCKET:-}" --request "$1" 2>/dev/null
}

# task register / record — RECORDER ops, authorized server-side by peer uid against a
# trusted recorder allowlist. The trusted registry (not task.json) binds the project
# target, baseline and approved candidate content.
task_register() {
  local id="${1:?task register <id>}" td wt proj branch base req
  _verify_paths "$id"
  branch="$(task_field "$td/task.json" branch)"; base="$(task_field "$td/task.json" base)"
  req="$(python3 -c 'import json,sys;print(json.dumps({"protocol":"AEGL-BROKER/1","op":"register","task_id":sys.argv[1],"project":sys.argv[2],"base":sys.argv[3],"worktree":sys.argv[4],"branch":sys.argv[5]}))' "$id" "$proj" "$base" "$wt" "$branch")"
  broker_call "$req"
}

task_record() {
  local id="${1:?task record <id>}" td wt proj branch base digest req
  _verify_paths "$id"
  branch="$(task_field "$td/task.json" branch)"; base="$(task_field "$td/task.json" base)"
  digest="$(python3 "$AEGL_ROOT/recovery/promotion_core.py" digest "$wt" "$base" "$branch")"
  req="$(python3 -c 'import json,sys;print(json.dumps({"protocol":"AEGL-BROKER/1","op":"record","task_id":sys.argv[1],"verify_result":"PASS","candidate_digest":sys.argv[2]}))' "$id" "$digest")"
  broker_call "$req"
}

# task promote — requester op. The broker re-pins the candidate against its registry,
# re-validates, then applies; this side never applies the diff or touches the canonical
# project after the reply.
task_promote() {
  local id="${1:?task promote <id>}"
  controller_auth || die "task promote authentication failed"
  _verify_paths "$id"
  require_broker   # default-deny: a verified independent broker is mandatory
  local reply rc
  reply="$(broker_call "{\"protocol\":\"AEGL-BROKER/1\",\"op\":\"promote\",\"task_id\":\"$id\"}")"; rc=$?
  say "BROKER_REPLY=$reply"
  case "$rc" in
    0) say "PROMOTE=APPLIED id=$id"; return 0 ;;
    3) say "PROMOTE_REJECTED id=$id"; return 3 ;;
    *) say "PROMOTE_FAILED id=$id"; return 4 ;;
  esac
}

task_discard() {
  local id="${1:?task discard <id>}" td wt proj branch
  controller_auth || die "task discard authentication failed"
  _verify_paths "$id"
  branch="$(task_field "$td/task.json" branch)"
  git -C "$proj" worktree remove --force "$wt" >/dev/null 2>&1 || rm -rf "$wt"
  git -C "$proj" branch -D "$branch" >/dev/null 2>&1 || true
  rm -rf "$td"
  say "TASK_DISCARDED id=$id"
}

case "${1:-}" in
  boundary) shift; sub="${1:-}"; shift || true
            case "$sub" in
              audit) boundary_audit ;;
              rulesync) [ "${1:-}" = plan ] || die "usage: boundary rulesync plan"; rulesync_plan ;;
              *) die "usage: boundary {audit|rulesync plan}" ;;
            esac ;;
  task) shift; sub="${1:-}"; shift || true
        case "$sub" in
          start) task_start "$@" ;; verify) task_verify "$@" ;;
          register) task_register "$@" ;; record) task_record "$@" ;;
          promote) task_promote "$@" ;; discard) task_discard "$@" ;;
          *) die "usage: task {start|verify|register|record|promote|discard}" ;;
        esac ;;
  controller) shift; [ "${1:-}" = probe ] || die "usage: controller probe <id> <cmd>"; shift; controller_probe "$@" ;;
  identity)   shift; [ "${1:-}" = status ] || die "usage: identity status"; identity_status ;;
  *) sed -n '2,18p' "$0"; exit 2 ;;
esac
