#!/usr/bin/env bash
# aegl-promote-broker — the independent AEGL promotion broker (identity: aegl-promote).
#
#   serve   run the broker daemon on $AEGL_BROKER_SOCKET
#   client  submit a bounded request (--task <id> [--op promote|validate]) and print the reply
#
# The broker validates AND applies promotions through recovery/promotion_core.py; a
# client only ever submits an op + task_id — never a shell command or target path.
set -uo pipefail
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BROKER_PY="$SELF_DIR/../recovery/promotion_broker.py"

case "${1:-}" in
  serve)
    : "${AEGL_BROKER_SOCKET:?AEGL_BROKER_SOCKET must be set}"
    exec python3 "$BROKER_PY" serve --socket "$AEGL_BROKER_SOCKET" ;;
  client)
    shift
    : "${AEGL_BROKER_SOCKET:?AEGL_BROKER_SOCKET must be set}"
    exec python3 "$BROKER_PY" client --socket "$AEGL_BROKER_SOCKET" "$@" ;;
  *)
    sed -n '2,8p' "$0"; exit 2 ;;
esac
