#!/usr/bin/env bash
# aegl-model-broker — trusted egress + credential handoff for a sandboxed Hermes.
# Runs OUTSIDE the sandbox; it is the only holder of the model credential and the
# only component with external egress.
#
#   AEGL_MODEL_UPSTREAM=<https base> AEGL_MODEL_CREDENTIAL_FILE=<path> \
#     aegl-model-broker serve --socket <unix>
set -uo pipefail
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BROKER_PY="$SELF_DIR/model_broker.py"
[ -f "$BROKER_PY" ] || BROKER_PY="$SELF_DIR/../recovery/model_broker.py"
[ -f "$BROKER_PY" ] || { echo "BLOCKED: model_broker.py not found next to $SELF_DIR" >&2; exit 2; }

case "${1:-}" in
  serve)
    : "${AEGL_MODEL_SOCKET:?AEGL_MODEL_SOCKET must be set}"
    : "${AEGL_MODEL_UPSTREAM:?AEGL_MODEL_UPSTREAM must be set}"
    exec python3 "$BROKER_PY" serve \
      --socket "$AEGL_MODEL_SOCKET" \
      --upstream "$AEGL_MODEL_UPSTREAM" \
      --credential-env "${AEGL_MODEL_CREDENTIAL_ENV:-COMMANDCODE_API_KEY}" \
      --credential-file "${AEGL_MODEL_CREDENTIAL_FILE:-}" \
      ${AEGL_MODEL_AUTH_HEADER:+--auth-header "$AEGL_MODEL_AUTH_HEADER"} ;;
  *)
    sed -n '2,9p' "$0"; exit 2 ;;
esac
