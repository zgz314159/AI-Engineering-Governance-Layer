#!/usr/bin/env bash
# Operator configuration only. Never put an API key on this command line.
set -euo pipefail
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
SELF_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
HELPER="$SELF_DIR/model_config.py"
[ -f "$HELPER" ] || HELPER="$SELF_DIR/../recovery/model_config.py"
exec /usr/bin/python3 "$HELPER" "$@"
