[Unit]
Description=AEGL entry RW self-bind /home/zhong/Projects/Google-Android-Agent-Development-Stack
Documentation=file:///usr/local/lib/aegl-entry-bind/PARENT-ENTRY-BIND.md
DefaultDependencies=no
Conflicts=umount.target
Before=local-fs.target aegl-entry-bind.target
After=local-fs-pre.target home-zhong-Projects.mount
