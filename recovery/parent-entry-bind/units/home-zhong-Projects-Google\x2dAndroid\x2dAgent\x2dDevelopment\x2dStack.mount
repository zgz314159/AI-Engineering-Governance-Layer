[Mount]
What=/home/zhong/Projects/Google-Android-Agent-Development-Stack
Where=/home/zhong/Projects/Google-Android-Agent-Development-Stack
Type=none
Options=bind,rw

[Install]
WantedBy=aegl-entry-bind.target
