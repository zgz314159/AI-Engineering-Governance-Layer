{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/zgz46408212-jpg/AI-Engineering-Governance-Layer/core/continuity/state.schema.json",
  "title": "AEGL Continuity state.json",
  "description": "Machine-readable continuity snapshot. state.json is the canonical truth; HANDOFF.md and NEXT-SESSION.md are projections of it. See AEGL-v1.3-Continuity-Layer-Build-Plan.md.",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "project", "repository", "ci", "phase", "work", "next"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "project": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string" }
      }
    },
    "repository": {
      "type": "object",
      "required": ["branch", "head", "dirty"],
      "properties": {
        "branch": { "type": "string" },
        "head": { "type": "string", "pattern": "^([0-9a-fA-F]{4,40})?$" },
        "dirty": { "type": "boolean" },
        "remote": { "type": ["string", "null"] },
        "latestCommit": { "type": ["string", "null"] },
        "latestTag": { "type": ["string", "null"] }
      }
    },
    "ci": {
      "type": "object",
      "required": ["status", "checkedAt"],
      "properties": {
        "status": { "type": "string" },
        "runId": { "type": ["string", "null"] },
        "checkedAt": { "type": "string", "format": "date-time" }
      }
    },
    "phase": {
      "type": "object",
      "required": ["name", "status"],
      "properties": {
        "name": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "work": {
      "type": "object",
      "required": ["goal", "currentTask", "completed", "inProgress", "blocked",
                   "failedApproaches", "importantDecisions", "doNotRepeat",
                   "knownRisks", "openQuestions"],
      "properties": {
        "goal": { "type": "string" },
        "currentTask": { "type": "string" },
        "completed": { "$ref": "#/definitions/stringList" },
        "inProgress": { "$ref": "#/definitions/stringList" },
        "blocked": { "$ref": "#/definitions/stringList" },
        "failedApproaches": { "$ref": "#/definitions/stringList" },
        "importantDecisions": { "$ref": "#/definitions/stringList" },
        "doNotRepeat": { "$ref": "#/definitions/stringList" },
        "knownRisks": { "$ref": "#/definitions/stringList" },
        "openQuestions": { "$ref": "#/definitions/stringList" }
      }
    },
    "next": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": { "type": "string" },
        "command": { "type": "string" }
      }
    },
    "memory": {
      "description": "Read-only reference to the optional persistent-memory backend (v1.4). Never a copy of the Beads work graph.",
      "type": "object",
      "properties": {
        "backend": { "type": "string" },
        "available": { "type": "boolean" },
        "supported": { "type": "boolean" },
        "initialized": { "type": "boolean" },
        "beadsVersion": { "type": ["string", "null"] },
        "dataDir": { "type": ["string", "null"] },
        "readyCount": { "type": ["integer", "null"] },
        "currentTask": { "type": ["string", "null"] },
        "checkedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "definitions": {
    "stringList": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
